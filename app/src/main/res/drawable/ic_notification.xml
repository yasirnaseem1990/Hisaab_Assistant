<?xml version="1.0" encoding="utf-8"?>
<!--
  Small notification icon — MyHisaab "H" lettermark.
  Rules (Android 5.0+ / Material 3):
    • Fill must be #FFFFFF; the system ignores RGB and renders only the alpha
      channel, tinting the result with the accent colour supplied via setColor().
    • Strokes ≥ 4dp on a 24dp canvas so pixels survive status-bar downscaling.
    • No background fill — transparent pixels become invisible in every theme.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Left vertical bar -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M2,2 h5 v20 h-5 z" />

    <!-- Right vertical bar -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M17,2 h5 v20 h-5 z" />

    <!-- Crossbar — taller than before so it reads at status-bar scale -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M7,9 h10 v6 h-10 z" />

</vector>
